# ===== Required =====
BOT_TOKEN=your_telegram_bot_token_from_BotFather
GEMINI_API_KEY=your_google_gemini_api_key
ADMIN_ID=123456789          # your Telegram user id (send /id to the bot to get it)

# ===== Qdrant =====
QDRANT_URL=http://localhost:6333   # use :memory: for quick local testing
QDRANT_API_KEY=
COLLECTION_NAME=university_rag_v2

# ===== Gemini models (optional) =====
FLASH_MODEL=gemini-3.1-flash-lite
ANSWER_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
RPM_LIMITS=gemini-3.1-flash-lite=4

# ===== Retrieval (optional) =====
QUERY_TOP_K=15
CONTEXT_CHUNKS=4
